# 각자 자기 PostgreSQL 주소로 바꿔서 .env 로 복사해 쓴다. (.env 는 git에 올리지 않음)
# 형식: postgresql+psycopg2://사용자:비밀번호@호스트:포트/DB이름
DATABASE_URL=postgresql+psycopg2://postgres:비밀번호@localhost:5432/adguard

# local(개발) 또는 production(운영). production이면 개발용 시드가 실행되지 않음
APP_ENV=local
# 배포(HTTPS)에서는 true
COOKIE_SECURE=false
# Agent 완료 통지용 서비스 토큰. 기표님(Agent 쪽)과 같은 값을 쓴다
AGENT_TOKEN=
# 요청을 허용할 프론트 주소 (JSON 배열)
CORS_ORIGINS=["http://localhost:5173"]
