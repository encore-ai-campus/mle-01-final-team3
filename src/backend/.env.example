# 각자 자기 PostgreSQL 주소로 바꿔서 .env 로 복사해 쓴다. (.env 는 git에 올리지 않음)
# 형식: postgresql+psycopg2://사용자:비밀번호@호스트:포트/DB이름
DATABASE_URL=postgresql+psycopg2://postgres:비밀번호@localhost:5432/adguard

# local(개발) 또는 production(운영). local이 아니면 개발용 시드(app.seed_dev)가 실행되지 않음
APP_ENV=local
# 배포(HTTPS)에서는 true
COOKIE_SECURE=false
# 백엔드 ↔ Agent 서비스 토큰 (작업 요청·완료 통지·첨부 서명 모두). Agent 담당과 같은 값을 쓴다
AGENT_TOKEN=
# 요청을 허용할 프론트 주소 (JSON 배열)
CORS_ORIGINS=["http://localhost:5173"]

# ----- 검토 흐름·Agent 연동 (값을 안 쓰면 아래 기본값) -----
# 백엔드 → Agent 작업 요청 주소 (POST {AGENT_URL}/internal/v1/review-jobs)
AGENT_URL=http://localhost:9000
# Agent가 첨부 파일을 내려받을 백엔드 주소 (서명 URL 앞부분)
PUBLIC_BASE_URL=http://localhost:8000
# 실행 시간 초과(초). 실행을 만든 뒤 이 시간 안에 완료 통지가 없으면 RUN_TIMEOUT
RUN_TIMEOUT_SECONDS=180
# 첨부 파일 저장 폴더. 비우면 src/backend/storage/attachments
# ATTACHMENT_DIR=
