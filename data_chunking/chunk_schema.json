    },
    "text": {
      "type": "string"
    },
    "source_path": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_chunk_id": {
      "type": "string"
    },
    "source_page": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source_span": {
      "type": [
        "string",
        "null"
      ]
    },
    "article": {
      "type": [
        "integer",
        "null"
      ]
    },
    "paragraph": {
      "type": [
        "integer",
        "null"
      ]
    },
    "item": {
      "type": [
        "integer",
        "null"
      ]
    },
    "subitem": {
      "type": [
        "integer",
        "null"
      ]
    }
  }
}
