{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "document_id",
    "chunk_id",
    "parent_id",
    "chunk_type",
    "text",
    "source_path",
    "source_id",
    "source_chunk_id",
    "source_page",
    "source_span",
    "article",
    "paragraph",
    "item",
    "subitem"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "chunk_id": {
      "type": "string"
    },
    "parent_id": {
