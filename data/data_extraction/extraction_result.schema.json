{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mle-01-team3/extraction-result.schema.json",
  "title": "Knowledge extraction result",
  "description": "Extracted entities and relationships linked back to one or more source chunks. This schema is separate from the input chunk schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_id",
    "source",
    "relationship_result",
    "entities",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "extraction_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source_ref"
    },
    "relationship_result": {
      "enum": [
        "found",
        "none_found",
        "partial",
        "not_evaluated"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "relationship_result": {
            "const": "none_found"
          }
        },
        "required": ["relationship_result"]
      },
      "then": {
        "properties": {
          "relationships": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "relationship_result": {
            "const": "found"
          }
        },
        "required": ["relationship_result"]
      },
      "then": {
        "properties": {
          "relationships": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "chunk_id", "chunk_type"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "chunk_id": {"type": "string", "minLength": 1},
        "chunk_type": {
          "enum": ["addendum", "appendix", "article", "case", "guide", "item", "paragraph", "record", "subitem", "table"]
        },
        "source_path": {"type": ["string", "null"]},
        "source_page": {"type": ["integer", "null"], "minimum": 1},
        "source_span": {"type": ["string", "null"]},
        "article": {"type": ["integer", "null"], "minimum": 1},
        "paragraph": {"type": ["integer", "null"], "minimum": 1},
        "item": {"type": ["integer", "null"], "minimum": 1},
        "subitem": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "quote", "evidence_type"],
      "properties": {
        "source": {"$ref": "#/$defs/source_ref"},
        "quote": {"type": "string", "minLength": 1},
        "evidence_type": {
          "enum": ["direct_text", "structured_field", "curated_mapping", "retrieval_result"]
        },
        "supports": {
          "enum": ["entity_mention", "relationship", "candidate_generation"]
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type",
        "mention",
        "normalized_value",
        "official_id",
        "extraction_status",
        "evidence"
      ],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "entity_type": {
          "enum": [
            "Company",
            "Product",
            "Ingredient",
            "FunctionalClaim",
            "AllowedPhrase",
            "Advertisement",
            "AdvertisementClaim",
            "ViolationType",
            "LegalDocument",
            "LegalProvision",
            "Case",
            "ReviewRun",
            "ReviewDecision",
            "LegalReview",
            "FollowUpTask",
            "EnforcementAction"
          ]
        },
        "mention": {"type": "string", "minLength": 1},
        "normalized_value": {"type": ["string", "null"]},
        "official_id": {"type": ["string", "null"]},
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "extraction_status": {
          "enum": ["source_confirmed", "uncertain", "unresolved"]
        },
        "review_status": {
          "enum": ["not_reviewed", "pending", "approved", "rejected", "not_required"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "subject_id",
        "predicate",
        "object_id",
        "relationship_status",
        "evidence_type",
        "extraction_method",
        "review_status",
        "evidence"
      ],
      "properties": {
        "relationship_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "predicate": {
          "enum": [
            "MANUFACTURES",
            "CONTAINS",
            "HAS_CLAIM",
            "ALLOWS",
            "ADVERTISED_AS",
            "INDICATES_RISK_OF",
            "DETERMINES",
            "DEFINED_BY",
            "SUPPORTED_BY",
            "EVIDENCE_FROM",
            "HAS_LEGAL_REVIEW",
            "REQUIRES_FOLLOW_UP",
            "GENERATES_TASK",
            "PART_OF",
            "ISSUED_FOR",
            "REVIEWED_AS",
            "ANALYZES",
            "PRODUCES",
            "CONTAINS_EXPRESSION",
            "CLASSIFIED_AS",
            "GROUNDED_IN"
          ]
        },
        "object_id": {"type": "string", "minLength": 1},
        "relationship_status": {
          "enum": ["source_confirmed", "system_candidate", "human_confirmed", "unresolved"]
        },
        "evidence_type": {
          "enum": ["direct_text", "structured_field", "curated_mapping", "retrieval_result", "model_inference"]
        },
        "extraction_method": {
          "enum": ["structured_field_mapping", "rule_mapping", "model_extraction", "keyword_search", "vector_search", "graph_retrieval", "manual_entry"]
        },
        "review_status": {
          "enum": ["not_reviewed", "pending", "approved", "rejected", "not_required"]
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "valid_from": {"type": ["string", "null"], "format": "date"},
            "valid_to": {"type": ["string", "null"], "format": "date"},
            "condition": {"type": ["string", "null"]}
          }
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}
